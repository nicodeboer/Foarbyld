{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foarbyld",
  "version": "0.1.0",
  "identifier": "io.github.nicodeboer.foarbyld",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foarbyld",
        "width": 1100,
        "height": 800,
        "minWidth": 480,
        "minHeight": 360,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/pdfium/*"],
    "macOS": { "signingIdentity": "-", "hardenedRuntime": false },
    "category": "Productivity",
    "shortDescription": "Cross-platform document and image previewer",
    "fileAssociations": [
      { "ext": ["pdf"], "mimeType": "application/pdf", "name": "PDF Document", "role": "Viewer" },
      { "ext": ["md", "markdown"], "mimeType": "text/markdown", "name": "Markdown Document", "role": "Viewer" }
    ]
  }
}
